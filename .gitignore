# Rust / Cargo
/target/
.cargo/*
!.cargo/audit.toml

# flatpak-builder cache/build state (large, machine-local)
/.flatpak-builder/

# Editor swap/backup files
*.swp
*.swo
*~
\#*\#

# OS metadata
.DS_Store
Thumbs.db
release.md
CLAUDE.md
*PLAN.md
STABILITY-REVIEW-*.md

# Generated icons (produced by install.sh from the SVG source in assets/)
assets/icons/

# Typst build artefacts
*.pdf
*.png
# But track the app screenshot
!screenshots/*.png

# Reference style guide PDFs/EPUBs (local only)
Reference Documents/

# Working documents (local only)
*.typ
!templates/**/*.typ
!screenshots/demo-main.typ
!screenshots/example_template_one.typ

# Plans / future work (local only)
future-plans.md

# Zerkalo user data (never commit these)
*.todo
*.plan
global-todo.md
session.json
zerkalo.log
font-preferences.toml
keybindings.toml
plan.md
